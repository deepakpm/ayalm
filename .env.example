# Shared PostgreSQL database URL for all microservices
DATABASE_URL="postgresql://postgres:password@localhost:5432/alayam_db"

# API Gateway
GATEWAY_PORT=4000
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
CORS_ORIGIN="http://localhost:3000"

# Service URLs (used by API Gateway)
CATALOG_SERVICE_URL="http://localhost:4001"
BOOKING_SERVICE_URL="http://localhost:4002"
USER_SERVICE_URL="http://localhost:4003"

# Individual Service Ports
CATALOG_PORT=4001
BOOKING_PORT=4002
USER_PORT=4003
